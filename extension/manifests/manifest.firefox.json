{
  "manifest_version": 3,
  "name": "Un-Corporate",
  "version": "1.0.0",
  "description": "Scans policy pages, highlights user-impacting clauses, and explains them in plain language.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.openai.com/*"],
  "action": {
    "default_title": "Un-Corporate",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "un-corporate@example.local",
      "strict_min_version": "128.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/tokens.css",
        "src/ui/pixel-components.css",
        "src/content/sidebar.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
